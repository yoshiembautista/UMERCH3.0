{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "umerch",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-11",
  "upload_source_maps": true,
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "containers": [
    {
      "class_name": "UmerchContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "app": {
          "dockerfile": "./Dockerfile",
          // Public key only. Replace with your reCAPTCHA v2 site key.
          "build_vars": {
            "VITE_RECAPTCHA_SITE_KEY": ""
          }
        }
      }
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "UMERCH_CONTAINER",
        "class_name": "UmerchContainer"
      }
    ]
  },

  "exports": {
    "UmerchContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "vars": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "DB_CONNECTION": "pgsql",
    "SESSION_DRIVER": "database",
    "SESSION_SECURE_COOKIE": "true",
    "CACHE_STORE": "database",
    "QUEUE_CONNECTION": "database",
    "FILESYSTEM_DISK": "local",
    "LOG_CHANNEL": "stderr",
    "MAIL_MAILER": "brevo",
    "MAIL_FROM_NAME": "UM Merch"
  },

  "secrets": {
    "required": [
      "APP_KEY",
      "APP_URL",
      "DB_URL",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "R2_BUCKET",
      "R2_ENDPOINT",
      "R2_PUBLIC_URL",
      "BREVO_API_KEY",
      "MAIL_FROM_ADDRESS",
      "RECAPTCHA_SITE_KEY",
      "RECAPTCHA_SECRET_KEY"
    ]
  }
}
