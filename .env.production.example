# Production environment reference (Render Free + Neon + R2 + Brevo)
#
# These values are NOT read from a file at runtime. They are set in Render:
# either in render.yaml (non-secrets) or as environment variables marked
# `sync: false` in the Blueprint dashboard.
#
# This file documents the full set for local reference only.
# Never commit real credentials.

APP_NAME="UM Merch"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=

# Render injects this automatically (render.yaml maps RENDER_EXTERNAL_URL).
APP_URL=https://umerch.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Neon Postgres. Use the direct (non-pooled) connection string.
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# The app's "public" disk switches to R2 whenever R2_BUCKET is set.
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-domain>

# Render Free blocks outbound SMTP (ports 25/465/587), so OTP email is sent
# through Brevo's HTTPS API. The transport is registered in AppServiceProvider.
MAIL_MAILER=brevo
BREVO_API_KEY=
# Must be a verified sender (or domain) in Brevo.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="UM Merch"

# reCAPTCHA v2 keys. The site key is shared with the frontend at runtime by
# HandleInertiaRequests, so it is a normal environment variable now.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
