# Production environment reference (Cloudflare Containers)
#
# These values are NOT read from a file at runtime. The container receives its
# environment from the Worker. Set secrets with:
#
#   npx wrangler secret put NAME
#
# Non-secret values live in wrangler.jsonc under "vars". This file documents
# the full set for local reference only. Never commit real credentials.

APP_NAME="UM Merch"
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# public workers.dev URL, or your custom domain
APP_URL=https://umerch.<your-subdomain>.workers.dev

# Neon Postgres. The pooled connection string is fine for the app.
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# The app's "public" disk switches to R2 whenever R2_BUCKET is set.
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-domain>

LOG_CHANNEL=stderr

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="UM Merch"

# Server-side verification
RECAPTCHA_SECRET_KEY=

# Build-time only (public): set in wrangler.jsonc containers[].images.app.build_vars
VITE_RECAPTCHA_SITE_KEY=
