# Local Wrangler secrets for `npx wrangler dev`
#
# Copy to `.dev.vars` (gitignored) and fill in test values. This file is not
# used by `wrangler deploy`; production secrets are set with
# `npx wrangler secret put NAME`.

APP_KEY=
APP_URL=http://localhost:8787
DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-domain>

RECAPTCHA_SECRET_KEY=
MAIL_MAILER=log
